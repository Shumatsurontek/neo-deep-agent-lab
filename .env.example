# Modal credentials (get from https://modal.com/settings)
MODAL_TOKEN_ID=your_modal_token_id
MODAL_TOKEN_SECRET=your_modal_token_secret

# LLM API key (Anthropic by default)
ANTHROPIC_API_KEY=your_anthropic_api_key

# Optional: Use OpenAI instead
# OPENAI_API_KEY=your_openai_api_key
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-5-mini-2025-08-07

# Defaults
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-20250514
SQL_TIMEOUT_MS=10000
MAX_RESULT_ROWS=50
SERVER_PORT=8080

# Persistence (local PostgreSQL for store + checkpointer)
DATABASE_URL=postgresql://postgres:postgres@localhost:17/neo_agent

# Logging
LOG_LEVEL=INFO
LOG_MODE=dev  # "dev" for human-readable, "json" for structured JSON (ELK/Datadog)

# Session
SESSION_TTL_SECONDS=3600

# LangSmith tracing (optional)
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=your_langsmith_api_key
# LANGCHAIN_PROJECT=neo-deep-agent-lab

# Context engineering
RECALL_ENABLED=true
RECALL_LIMIT=3
RECALL_MIN_SCORE=0.3

# Hybrid search (ParadeDB BM25 + vector)
HYBRID_SEARCH_ENABLED=true
HYBRID_VECTOR_WEIGHT=0.6
HYBRID_BM25_WEIGHT=0.4
